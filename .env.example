OPENAI_API_KEY=sk-proj-your-key-here
# Najtaniej: gpt-5.4-nano. Lepsza jakosc tekstu: gpt-5.4-mini.
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_ANALYSIS_MODEL=gpt-5.4-nano
OPENAI_PROMPT_MODEL=gpt-5.4-nano
OPENAI_LISTING_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=5173

# Produkcja: ustaw dowolny długi sekret i wpisz ten sam klucz w CRM.
APP_KEY=wpisz_tutaj_dlugi_sekret_crm
# Opcjonalnie: hasło do wejścia bezpośredniego poza CRM.
APP_PASS=wpisz_tutaj_haslo_do_panelu
# Opcjonalnie: osobne konta użytkowników. Format: login:haslo,login2:haslo2
# APP_USERS=grzegorz:haslo_grzegorza,daria:haslo_darii
# Opcjonalnie: dodatkowi administratorzy panelu profili.
# APP_ADMINS=freehome,grzegorz
# FRAME_ANCESTORS='self' https://crm.freehome.pl
